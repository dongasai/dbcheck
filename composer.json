{
    "name": "dongasai/dbcheck",
    "description": "数据库结构/数据自检与修复框架（按表三类检查：表结构、固定数据、字段明细）",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "database", "schema", "check"],
    "require": {
        "php": ">=7.4",
        "illuminate/console": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "illuminate/config": "^8.0 || ^9.0 || ^10.0 || ^11.0 || ^12.0",
        "phpunit/phpunit": "^9.6"
    },
    "suggest": {
        "doctrine/dbal": "在 Laravel 8 / 9 等未内置原生列修改的版本上，修复已有列（column.* 整列重写，底层 Blueprint::change()）需要安装 doctrine/dbal；较新的 Laravel 已内置原生列修改，无需安装"
    },
    "autoload": {
        "psr-4": {
            "Dongasai\\Dbcheck\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dongasai\\Dbcheck\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --bootstrap tests/bootstrap.php tests"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dongasai\\Dbcheck\\DbcheckServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
